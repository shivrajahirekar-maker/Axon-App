  "chapters": [
    {
      "key": "focus",
      "title": "Focus",
      "stop": "The Meadow of Many Things",
      "intro": "The trail opens onto a meadow full of bright, drifting things. {guide} walks beside {hero} here, just noticing.",
      "outro": "{hero} has crossed the meadow. {guide}: “Thank you for walking me through that.”",
      "qids": [
        "A-ATT-1",
        "A-ATT-2",
        "A-ATT-3"
      ]
    },
    {
      "key": "energy",
      "title": "Energy & Impulses",
      "stop": "The Restless Stream",
      "intro": "Ahead, a stream moves quickly over the stones. {guide} watches how {hero} feels beside it.",
      "outro": "The stream is behind {hero} now. {guide}: “That took a bit of patience. Well done.”",
      "qids": [
        "A-HYP-1",
        "A-HYP-2",
        "A-HYP-3"
      ]
    },
    {
      "key": "starting",
      "title": "Getting Started",
      "stop": "The Foot of the Hill",
      "intro": "A hill rises ahead. {guide} wonders what taking the first step is like for {hero}.",
      "outro": "{hero} has found the way up. {guide}: “Every first step counts, however small.”",
      "qids": [
        "A-ORG-1",
        "A-ORG-2",
        "A-ORG-3"
      ]
    },
    {
      "key": "feelings",
      "title": "Feelings",
      "stop": "The Weather Ridge",
      "intro": "On the ridge, feelings arrive like weather. {guide} asks how they land on {hero}.",
      "outro": "The weather has passed for now. {guide}: “Thank you for trusting me with that.”",
      "qids": [
        "A-EMO-1",
        "A-EMO-2",
        "A-EMO-3"
